PORT=8080
ENV=development
LOG_LEVEL=debug
GRACEFUL_SHUTDOWN_SECONDS=15

BRIDGE_API_KEY=changeme
ADMIN_API_KEY=changeme
WEBHOOK_SECRET_EVOLUTION=changeme
API_RATE_LIMIT=100,1m
API_INSTANCE_RATE=30,1m

CHATWOOT_ADMIN_API_URL=https://your-chatwoot-instance.example.com/api/v1
CHATWOOT_INTERNAL_URL=http://your-chatwoot-instance:3000
CHATWOOT_ADMIN_EMAIL=admin@example.com
CHATWOOT_ADMIN_PASSWORD=changeme
CHATWOOT_PLATFORM_API_TOKEN=changeme

# Config fixa da única conta Chatwoot (Cartão Pro) — bridge é single-tenant.
# Substituem a antiga tabela `tenants` (removida na migração 018).
# CHATWOOT_ACCOUNT_ID: ID numérico da conta Chatwoot da Cartão Pro.
# CHATWOOT_API_TOKEN: access_token de um usuário admin com acesso a essa conta.
# CHATWOOT_WEBHOOK_SECRET: secret HMAC gerado pelo Chatwoot na inbox "api"
#   (campo "secret" da inbox) — usado para validar POST /webhook/chatwoot.
CHATWOOT_ACCOUNT_ID=changeme
CHATWOOT_API_TOKEN=changeme
CHATWOOT_WEBHOOK_SECRET=changeme

# Webhooks
CHATWOOT_WEBHOOK_BASE=http://localhost:8080/webhook/evolution
# URL pública do app Next.js — usada só pra registrar o webhook de conta do
# addon "Widget de Chat" (Fase B). Opcional: ausente = CreateWidgetInbox
# funciona normalmente, só sem tempo real.
NEXTJS_APP_URL=https://example.com

EVOLUTION_BASE_URL=http://evolution-go:8080
EVOLUTION_API_KEY=changeme
# Nome da instância Evolution GO usada quando o caller não especifica uma
# explicitamente (ex: POST /notify/send sem "instance"). Opcional — sem isso,
# cai para a instância mais antiga cadastrada. Múltiplas instâncias (linhas
# WhatsApp) podem coexistir; isto só define qual é "a padrão".
EVOLUTION_INSTANCE=default

# Redis
REDIS_URL=redis://default:changeme@your-redis-host:6379

DATABASE_URL=postgres://postgres:changeme@your-db-host:5432/bridge?sslmode=disable
# meta_provider_configs vive nesse mesmo Postgres (migration 015) — não há
# mais DIRECTUS_DATABASE_URL nem SUPABASE_DATABASE_URL. addon_events foi
# removida (migration 018): existia só para alimentar uma plataforma externa
# (Directus/Linkko) que não existe mais nesta arquitetura.

META_TOKEN_ENCRYPTION_KEY_V1=changeme

DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=5

QUEUE_WORKERS=10
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=1000
CB_TIMEOUT_SECONDS=30
CB_MAX_REQUESTS=5
CB_FAILURE_THRESHOLD=0.5
